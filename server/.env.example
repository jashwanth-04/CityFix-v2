# Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit your actual .env file to version control

# MongoDB Connection String
# Format: mongodb://[username:password@]host:port/database
MONGO_URI=mongodb://localhost:27017/cityfix

# JWT Secret Key
# IMPORTANT: Use a strong, random string of at least 32 characters
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-secret-at-least-32-characters-long

# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment (development, production, test)
NODE_ENV=development

# Allowed Origins for CORS (production only, comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
